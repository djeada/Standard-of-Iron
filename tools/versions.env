# Standard of Iron - pinned developer tool versions
#
# Every formatter and linter used by `scripts/format.py` is pinned here so that
# a local run and a CI run produce byte-identical results.  The file is plain
# KEY=VALUE so it can be sourced from shell, read by CI, and parsed by
# scripts/format.py without a YAML/TOML dependency.
#
# Version policy enforced by `make format-doctor`:
#   * a different MAJOR version is an error - output would differ
#   * a different MINOR/PATCH version is a warning - usually compatible
#
# After bumping anything here, run `make format` and commit the resulting
# reformatting in a separate commit so review diffs stay readable.

# Tools marked "distro" below are whatever the CI base image (ubuntu-24.04)
# installs; the pin records that version so `format-doctor` is green on the
# same platform CI uses. Tools installed through pip are pinned exactly.

# ---- C / C++ / GLSL (distro: clang-format-18 / clang-tidy-18) ----
CLANG_FORMAT_VERSION=18.1.3
CLANG_TIDY_VERSION=18.1.3

# ---- QML (distro: qt6-declarative-dev-tools) ----
# QT_VERSION is the Qt the game is *built* against and is unrelated to the
# qmlformat/qmllint binaries, which come from the distro package.
QT_VERSION=6.8.2
QMLFORMAT_VERSION=6.4.2
QMLLINT_VERSION=6.4.2

# ---- Python ----
PYTHON_VERSION=3.12
BLACK_VERSION=24.10.0
RUFF_VERSION=0.8.6

# ---- Shell (distro: shellcheck; shfmt is optional) ----
SHELLCHECK_VERSION=0.9.0
SHFMT_VERSION=3.10.0

# ---- CMake ----
GERSEMI_VERSION=0.17.1

# ---- YAML / Markdown / JSON ----
YAMLLINT_VERSION=1.35.1
PRETTIER_VERSION=3.4.2
MARKDOWNLINT_CLI_VERSION=0.43.0

# ---- Hooks ----
PRE_COMMIT_VERSION=4.0.1
