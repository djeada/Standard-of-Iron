# The Qt Creator patterns above are name-based, so they would otherwise swallow
# CI files such as .github/workflows/build-linux.yml.
!.github/workflows/*
# Compiled translation catalogues. CMake builds these from translations/*.ts
# with lrelease on every build, so committing them only invites a .qm that has
# drifted from the .ts it claims to be.
*.qm
*.prl

# Qt unit tests
target_wrapper.*

# QtCreator
*.autosave

# QtCreator Qml
*.qmlproject.user
*.qmlproject.user.*

# QtCreator CMake
CMakeLists.txt.user*

# QtCreator 4.8< compilation database
compile_commands.json

# QtCreator local machine specific files for imported projects
*creator.user*

*_qmlcache.qrc

# Build directories. Anchored to the repo root: an unanchored pattern also
# matches asset directories that happen to be called "build".
/build/
/build-*/
tools/map_pipeline/build/
# Note: dist/ contains deployment configs and is tracked
dist/mesh/
_codeql_build_dir/
_codeql_detected_source_root

# Generated campaign map assets (pipeline outputs)
assets/campaign_map/*
# But keep validation and documentation files
!assets/campaign_map/valid_provinces.json
!assets/campaign_map/README.md
!assets/campaign_map/hannibal_path.json
!assets/campaign_map/campaign_state.json

# Generated creature animation and snapshot assets
assets/creatures/*.bpat
assets/creatures/*.bpsm
assets/creatures/*.bprm

# Local virtualenvs
venv/

# Python
__pycache__/
*.py[cod]
*$py.class
tools/assets/
assets/campaing_map/
tools/map_pipeline/assets/
tools/map_pipeline/build/
actionlint
.codex

# Generated Arena gameplay reports, traces, and frame captures
/artifacts/
