*build-*
# The Qt Creator patterns above are name-based, so they would otherwise swallow
# CI files such as .github/workflows/build-linux.yml.
!.github/workflows/*
# Compiled translation catalogues. CMake builds these from translations/*.ts
# with lrelease on every build, so committing them only invites a .qm that has
# drifted from the .ts it claims to be.
*.qm
*.prl

# Qt unit tests
target_wrapper.*

# QtCreator
*.autosave

# QtCreator Qml
*.qmlproject.user
*.qmlproject.user.*

# QtCreator CMake
CMakeLists.txt.user*

# QtCreator 4.8< compilation database
compile_commands.json

# QtCreator local machine specific files for imported projects
*creator.user*

*_qmlcache.qrc

# Build directories. Anchored to the repo root: an unanchored pattern also
# matches asset directories that happen to be called "build".
/build/
/build-*/
tools/map_pipeline/build/
# Note: dist/ contains deployment configs and is tracked
dist/mesh/
_codeql_build_dir/
_codeql_detected_source_root

# Generated campaign map assets (pipeline outputs)
assets/campaign_map/*
# But keep validation and documentation files
!assets/campaign_map/valid_provinces.json
!assets/campaign_map/README.md
!assets/campaign_map/hannibal_path.json
!assets/campaign_map/campaign_state.json
# ...and the pipeline outputs the build embeds. Natural Earth and NOAA are the
# source of truth for these, but neither host is dependable enough to sit in
# the path of a release build, so the generated results are committed.
!assets/campaign_map/campaign_base_color.png
!assets/campaign_map/campaign_water.png
!assets/campaign_map/coastlines_uv.json
!assets/campaign_map/rivers_uv.json
!assets/campaign_map/land_mesh.bin
!assets/campaign_map/provinces.json
!assets/campaign_map/terrain_height.png
!assets/campaign_map/terrain_height.json

# Generated creature animation and snapshot assets
assets/creatures/*.bpat
assets/creatures/*.bpsm
assets/creatures/*.bprm

# Most ambience beds are rendered from tools/audio_synth/ambience.py by the
# build. For those the recipe is the source and the .ogg is output.
assets/audio/ambience/*.ogg
assets/audio/ambience/*.wav

# The beds below are cut from public-domain field recordings instead, so there
# is no recipe to render them from and they have to be committed. They are
# rebuilt from their sources by tools/audio_field/build_beds.py, which needs a
# network. Keep this list and tools/audio_field/sources.py in step.
!assets/audio/ambience/alpine_mountain_pass.ogg
!assets/audio/ambience/battlefield_dry_wind_distant_march_01.ogg
!assets/audio/ambience/battlefield_dry_wind_distant_march_02.ogg
!assets/audio/ambience/camp_fire_night.ogg
!assets/audio/ambience/desert_army_march.ogg
!assets/audio/ambience/forest_ambush.ogg
!assets/audio/ambience/mediterranean_plains.ogg
!assets/audio/ambience/mountain_camp_night.ogg
!assets/audio/ambience/night_rain.ogg
!assets/audio/ambience/river_crossing.ogg
!assets/audio/ambience/roman_road.ogg
!assets/audio/ambience/weather_rain.ogg
!assets/audio/ambience/weather_snow.ogg

# Local virtualenvs
venv/

# Python
__pycache__/
*.py[cod]
*$py.class
tools/assets/
assets/campaing_map/
tools/map_pipeline/assets/
tools/map_pipeline/build/
actionlint
.codex

# Generated Arena gameplay reports, traces, and frame captures
/artifacts/

