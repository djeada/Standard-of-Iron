root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,ipp,inl,tpp,frag,vert,glsl}]
indent_size = 2

[*.qml]
indent_size = 4

[*.py]
indent_size = 4

[*.{sh,bash}]
indent_size = 2

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
