  "events": [],
  "commander_messages": [
    {
      "id": "sepulcher_bridge_open",
      "speaker": "roman_field_commander",
      "pose": "dismissive",
      "trigger": {
        "type": "mission_start",
        "delay": 2.0
      },
      "text": "One bridge, two ridges and a gate. Bows on both ridges, spears behind the gate, and nobody stands on that bridge unless I am standing on it with him. The dead do not tire, so we do not stand where they can reach us for longer than we must.",
      "voice_cue": "alert.commander_message",
      "duration": 10.0,
      "priority": 100
    },
    {
      "id": "sepulcher_bridge_first_rising",
      "speaker": "roman_field_commander",
      "pose": "cynical",
      "trigger": {
        "type": "wave_incoming",
        "owner_id": 2,
        "delay": 0.5,
        "final_wave": false
      },
      "text": "The barrows are opening. Let them come to the bridge; every one of them has to cross it, and it is only seven paces wide.",
      "voice_cue": "alert.commander_message",
      "duration": 8.0,
      "priority": 60
    },
    {
      "id": "sepulcher_bridge_last_rising",
      "speaker": "roman_field_commander",
      "pose": "dismissive",
      "trigger": {
        "type": "wave_incoming",
        "owner_id": 2,
        "delay": 0.5,
        "final_wave": true
      },
      "text": "That is the whole of the barrows on the road, kings and all. Hold this one and nothing else comes out of the ground until spring.",
      "voice_cue": "alert.commander_message",
      "duration": 9.0,
      "priority": 65
    },
    {
      "id": "sepulcher_bridge_losses",
      "speaker": "roman_field_commander",
      "pose": "cynical",
      "trigger": {
        "type": "heavy_losses",
        "owner_id": "player",
        "cooldown": 120
      },
      "text": "Pull the broken files back behind the gate and put fresh men on the ridge. Nobody fights the dead on open ground.",
      "voice_cue": "alert.commander_message",
      "duration": 8.0,
      "priority": 40,
      "once": false
    },
    {
      "id": "sepulcher_bridge_victory",
      "speaker": "roman_field_commander",
      "pose": "cynical",
      "trigger": {
        "type": "mission_victory",
        "delay": 1.0
      },
      "text": "The bridge is ours and the barrows are empty. Burn what is lying on it before it remembers how to stand.",
      "voice_cue": "alert.commander_message",
      "duration": 9.0,
      "priority": 120
    },
    {
      "id": "sepulcher_bridge_defeat",
      "speaker": "roman_field_commander",
      "pose": "dismissive",
      "trigger": {
        "type": "mission_defeat",
        "delay": 1.0
      },
      "text": "The bridge is gone. Take the south road and do not stop, and do not look back at who is following.",
      "voice_cue": "alert.commander_message",
      "duration": 9.0,
      "priority": 120
    }
  ],
  "theme": "Seven paces of stone, and everything in the barrows has to walk across it.",
