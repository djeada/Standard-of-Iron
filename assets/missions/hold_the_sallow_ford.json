  "events": [],
  "commander_messages": [
    {
      "id": "ford_open",
      "speaker": "roman_field_commander",
      "pose": "dismissive",
      "trigger": {
        "type": "mission_start",
        "delay": 2.0
      },
      "text": "The spur splits them for us, which is the only kindness this ground offers. Cart gate west, goat path east, and they only meet where we are standing. You cannot hold both mouths. Pick one, hold it, and move when the horns tell you to.",
      "voice_cue": "alert.commander_message",
      "duration": 9.0,
      "priority": 100
    },
    {
      "id": "ford_victory",
      "speaker": "roman_field_commander",
      "pose": "cynical",
      "trigger": {
        "type": "mission_victory",
        "delay": 1.0
      },
      "text": "Five columns and the ford still ours. Count the men twice and do not write the number down until morning; it is always worse in the dark and always worse again in daylight.",
      "voice_cue": "alert.commander_message",
      "duration": 9.0,
      "priority": 120
    },
    {
      "id": "ford_defeat",
      "speaker": "roman_field_commander",
      "pose": "dismissive",
      "trigger": {
        "type": "mission_defeat",
        "delay": 1.0
      },
      "text": "The redoubt is gone. Go south, keep the spur on your left, and do not stop to look at the ford. There is nothing there now that is worth a second of your life.",
      "voice_cue": "alert.commander_message",
      "duration": 9.0,
      "priority": 120
    }
  ],
  "theme": "The ground does half the work. The other half is knowing when to leave the lane you are winning."
}
