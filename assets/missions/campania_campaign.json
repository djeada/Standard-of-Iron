  "victory_conditions": [
    {
      "type": "survive_waves",
      "wave_count": 3,
      "description": "Break all three Roman assault phases. The quarter holds when the last consular column is dead in the streets."
    },
    {
      "type": "eliminate_commanders",
      "description": "Kill every enemy commander. A nation dies with the man who leads it: its camps fall neutral, its works come down and its troops leave the field."
    }
  ],
  "defeat_conditions": [
    {
      "type": "lose_structure",
      "structure_type": "barracks",
      "description": "If the central camp falls, the Campanian alliance dies with it."
    },
    {
      "type": "lose_all_units",
      "description": "No living formation remains to hold the gates."
    },
    {
      "type": "lose_commander",
      "description": "Hannibal falls, and the allied towns abandon the field."
    },
    {
      "type": "only_commander_remaining",
      "description": "A commander alone cannot defend a city quarter."
    }
  ],
  "optional_objectives": [
    {
      "type": "control_structures",
      "structure_types": [
        "marketplace",
        "home"
      ],
      "min_count": 5,
      "description": "Preserve the market and four homes: Campania is being defended for its people and supplies, not merely its walls."
    },
    {
      "type": "capture_structures",
      "structure_types": [
        "barracks"
      ],
      "min_count": 1,
      "description": "Between assaults, seize the eastern Roman siege camp."
    }
  ],
  "stages": [
    {
      "id": "break_assaults",
      "type": "survive_waves",
      "wave_count": 3,
      "title": "Break the three assault phases",
      "description": "Hold the Punic quarter through every consular column.",
      "hint": "The quarter holds when the last column is dead in the streets."
    },
    {
      "id": "kill_commanders",
      "type": "eliminate_commanders",
      "title": "Kill the Roman commanders",
      "description": "Break the siege camp once the assaults are spent.",
      "hint": "The siege works stand to the east of the quarter.",
      "target": {
        "x": 566,
        "z": 300
      },
      "target_radius": 30.0
    }
  ],
