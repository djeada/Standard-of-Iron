#version 430 core

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 5) buffer RiggedDrawCommand {
  uint count;
  uint instance_count;
  uint first_index;
  uint base_vertex;
  uint base_instance;
  uint surviving;
  uint overflowed;
} rg_cmd;

uniform uint u_out_capacity_triangles;

void main() {
  uint drawn = min(rg_cmd.surviving, u_out_capacity_triangles);
  rg_cmd.count = drawn * 3u;
  rg_cmd.instance_count = drawn > 0u ? 1u : 0u;
  rg_cmd.first_index = 0u;
  rg_cmd.base_vertex = 0u;
  rg_cmd.base_instance = 0u;
}
