  "_baseline_comment": [
    "Edges that point the wrong way today, counted per source->destination module",
    "pair. Each number is a debt, not a permission. The check fails if a count goes",
    "up, if a new pair appears, or if a count goes down without this file being",
    "updated to match -- so paying a debt down is recorded rather than reabsorbed.",
    "",
    "Every module already backed by its own CMake target is absent from this list,",
    "and must stay absent: for those the linker is the check and this file is only a",
    "second opinion."
  ],
  "baseline": {
    "combat -> audio": 1,
    "combat -> simulation": 8,
    "economy -> session": 1,
    "economy -> simulation": 2,
    "formations -> simulation": 1,
    "navigation -> combat": 3,
    "navigation -> formations": 3,
    "navigation -> simulation": 4,
    "registries -> formations": 4,
    "registries -> navigation": 4,
    "registries -> session": 2,
